            }
          },
          {
            "name": "alcunha",
            "in": "query",
            "description": "Alcunha",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pai",
            "in": "query",
            "description": "Nome do pai",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mae",
            "in": "query",
            "description": "Nome da mãe",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dataNascimento",
            "in": "query",
            "description": "Data de nascimento no formato YYYY-MM-DD (ex.: 2026-01-20)",
